# Drift Watch — environment configuration (Phase 5, P1 LLM adapter)
#
# Copy this file to `.env` and fill in values. `.env` is git-ignored;
# never commit real credentials. With DRIFT_WATCH_LLM_PROVIDER=none (the
# default) the entire product runs fully deterministically — no API key
# is needed for the backend, frontend, demo, or tests.

# --- LLM adapter (P1) -------------------------------------------------
# Provider for the pluggable planner/synthesis adapters (backend/llm.py).
# "none" = deterministic implementations only (default, no network calls).
# "openai" = any OpenAI-compatible /chat/completions endpoint.
DRIFT_WATCH_LLM_PROVIDER=none

# Model name as your provider expects it (e.g. gpt-4o-mini).
DRIFT_WATCH_LLM_MODEL=

# API key. Credentials are read ONLY from the environment / .env file.
DRIFT_WATCH_LLM_API_KEY=

# Base URL of an OpenAI-compatible API (override for Azure/OpenRouter/
# local gateways, e.g. http://localhost:11434/v1).
DRIFT_WATCH_LLM_BASE_URL=https://api.openai.com/v1

# Provider call timeout in seconds. On timeout/failure the system falls
# back to the deterministic implementations automatically.
DRIFT_WATCH_LLM_TIMEOUT=20

# --- Backend ----------------------------------------------------------
# SQLite database file (created automatically). Leave unset to use
# backend/drift_watch.db.
# DRIFT_WATCH_DB=
